# Copy this file to .env and customize your local settings.
# .env is gitignored so your local ports and credentials stay private.

# Web UI port (default: 8080; set to 0 for a random free port)
PORT=8080

# Optional: overrides PORT if set
# SCHEMA_DRIFT_PORT=8080

# Optional: full bind host and port (overrides PORT / SCHEMA_DRIFT_PORT)
# SCHEMA_DRIFT_ADDR=127.0.0.1:8080

# Optional: default CLI comparison DSNs (used when --a / --b flags are omitted)
# SCHEMA_DRIFT_A=mysql://readonly:secret@127.0.0.1:3306/app_staging
# SCHEMA_DRIFT_B=mysql://readonly:secret@127.0.0.1:3306/app_prod

# Optional: disable ANSI terminal colors when non-empty
# NO_COLOR=1
